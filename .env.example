# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 절대 커밋하지 마세요.

# --- DB (docker-compose 와 파이썬 코드가 함께 사용) ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me-admin
POSTGRES_DB=pii_rag
RAG_PASSWORD=change-me-rag
VAULT_PASSWORD=change-me-vault
MIGRATION_PASSWORD=change-me-migration
DB_HOST=localhost
DB_PORT=5433

# --- 임베딩 (OpenAI 호환 API) ---
# EMBED_PROVIDER=api   : 제공된 임베딩 API 키 사용 (마스킹된 텍스트만 전송됨)
# EMBED_PROVIDER=local : API 없이 동작만 확인하는 해시 임베딩 (검색 품질 낮음, 테스트 전용)
EMBED_PROVIDER=local
EMBED_API_BASE=https://clovastudio.stream.ntruss.com/v1/openai
EMBED_API_KEY=nv-cc
EMBED_MODEL=bge-m3
# DB 임베딩 차원과 같아야 합니다. 변경 시 재임베딩 계획이 필요하며 기존 DB를 삭제하지 마세요.
EMBED_DIM=1024
# 임베딩 요청 사이 쉬는 시간(초). CLOVA 테스트 키 한도가 분당 60회라 2초면 안전
EMBED_SLEEP=2

# --- LLM (OpenAI 호환 API, chat.py 에서 사용) ---
LLM_API_BASE=https://clovastudio.stream.ntruss.com/v1/openai
LLM_API_KEY=nv-cc
LLM_MODEL=HCX-007

# --- 탐지 모델 (pii_pipeline.py 에서 사용) ---
# 실전 1에서 학습한 KLUE-RoBERTa-small v1 모델 폴더. 기본값이 models/roberta_small_v1 이라 다른 곳에 둘 때만 변경
# PII_MODEL_DIR=models/roberta_small_v1

# --- 가명처리 ---
# HMAC 비밀키. 팀에서 임의의 긴 문자열로 정하고 절대 커밋하지 마세요.
HMAC_KEY=abcd
# 데이터 버전. 키를 바꿀 때 HMAC_KEY 와 함께 바꿉니다 (절차: docs/키_교체_절차.md)
DATA_VERSION=v1
# 키 교체 준비 중에만: 새 키로 v2 를 미리 적재할 때 쓰는 값 (전환 후 삭제)
# NEW_HMAC_KEY=

# --- 검색 (search.py 에서 사용) ---
# v1: 의미 검색만 / v2: 토큰 필터 any / v3: 토큰 필터 all → any (채택) / v4: 의미 점수 + 토큰 가산점
SEARCH_MODE=v3
# 지역 토큰 (시도+시군구): 부분 주소 질의('서울시 구로구 고객') 검색용. 켜면 다시 적재 (starter/region.py)
SEARCH_REGION=1

# 하이브리드 (RoBERTa × koelectra)
PII_HYBRID=1
PII_HYBRID_MODEL=models/koelectra_ft5
PII_HYBRID_TAU_ACCEPT=0.5
PII_HYBRID_TAU_REVIEW=0.5
PII_HYBRID_DROP_UNAGREED=0
PII_HYBRID_NUM_UNION=1

# 팀 기준: '김 과장'은 개인정보로 보지 않음 (정답 데이터 기준)
PII_HYBRID_NAME_FILTER=none
PII_SURNAME_TITLE_IS_PII=0

# 앙상블 끔 (효과 없음, 속도만 느려짐)
PII_ENSEMBLE=0

# 이름 보강 규칙 끔 (블라인드: 오탐/문서 0.78→0.37, 경계 오류 24→37, 노출은 둘 다 2) · 주소 보정은 켬
PII_BOOST_PERSON=0
PII_BOOST_ADDRESS=1

# 탐지 모델 (v1: dev 로만 학습한 RoBERTa-small)
PII_MODEL_DIR=models/roberta_small_v1

# V6 통합 탐지: 같은 프로세스에서 직접 실행 (서버 불필요)
PII_V6=inproc
# PII_V6_URL=http://127.0.0.1:8765   ← 서버 방식을 쓸 때만. PII_V6=inproc 이면 무시됨

# V6 실패 시 이 시간(초) 동안 하이브리드 단독으로 동작, 지난 뒤 다시 시도 (기본 60)
PII_V6_RETRY_S=60

# V6 모델 다운로드용 Hugging Face 토큰. .env 에만 각자 본인 토큰을 넣으세요 (이 파일에 값 쓰지 말 것, 공유 금지)
# HF_TOKEN=

# 출력 재검사: 1이면 켬 (근거 표기 정리·토큰 검사·원문 재탐지·문장 근거 대조)
# 탐지 검토 화면(/admin#detect) 연결 전까지는 끔
RECHECK=0

# --- 인물사전 연결 (서버 관리자 화면에서 실행별 선택 가능) ---
# strict: 엄격 / balanced: 기본 / relaxed: 완화. 이름만으로 연결하지 않습니다.
PID_SENSITIVITY=balanced
# 원문 JSONL 경로. 기본 data/holdout_labeled.jsonl (정답 라벨은 사용하지 않음)
# PID_SOURCE_PATH=/srv/rag/data/holdout_labeled.jsonl
# PID_REPORT_DIR는 지정하지 않으면 저장소 밖의 서버 관리자 비공개 폴더 사용

# --- DB 백업 (python -m starter.db_backup, 절차: docs/DB_백업_복원.md) ---
# 비우면 %LOCALAPPDATA%\RagServerAdmin\db_backups (본인만 접근). 다른 곳은 절대 경로로, 접근 권한은 직접 관리
# DB_BACKUP_DIR=
# DB_BACKUP_KEEP=14
# 서버 3(우분투)에서만: 백업 폴더를 서버 2 로 복사 (사용자@서버:/절대경로)
# DB_BACKUP_COPY_TO=backup_rag@10.0.0.12:/var/backups/pii_rag
