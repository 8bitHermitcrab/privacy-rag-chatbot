# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 절대 커밋하지 마세요.

# --- DB (docker-compose 와 파이썬 코드가 함께 사용) ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me-admin
POSTGRES_DB=pii_rag
RAG_PASSWORD=change-me-rag
VAULT_PASSWORD=change-me-vault
DB_HOST=localhost
DB_PORT=5433

# --- 임베딩 (OpenAI 호환 API) ---
# EMBED_PROVIDER=api   : 제공된 임베딩 API 키 사용 (마스킹된 텍스트만 전송됨)
# EMBED_PROVIDER=local : API 없이 동작만 확인하는 해시 임베딩 (검색 품질 낮음, 테스트 전용)
EMBED_PROVIDER=local
EMBED_API_BASE=https://clovastudio.stream.ntruss.com/v1/openai
EMBED_API_KEY=nv-cc
EMBED_MODEL=bge-m3
# DB 테이블 차원과 반드시 같아야 함. 바꾸면 docker compose down -v 후 다시 up
EMBED_DIM=1024
# 임베딩 요청 사이 쉬는 시간(초). CLOVA 테스트 키 한도가 분당 60회라 2초면 안전
EMBED_SLEEP=2

# --- LLM (OpenAI 호환 API, chat.py 에서 사용) ---
LLM_API_BASE=https://clovastudio.stream.ntruss.com/v1/openai
LLM_API_KEY=nv-cc
LLM_MODEL=HCX-005

# --- 탐지 모델 (pii_pipeline.py 에서 사용) ---
# 실전 1에서 학습한 KLUE-RoBERTa-small v1 모델 폴더. 기본값이 models/roberta_small_v1 이라 다른 곳에 둘 때만 변경
# PII_MODEL_DIR=models/roberta_small_v1

# --- 가명처리 ---
# HMAC 비밀키. 팀에서 임의의 긴 문자열로 정하고 절대 커밋하지 마세요.
HMAC_KEY=abcd

# --- 검색 (search.py 에서 사용) ---
# v1: 의미 검색만 / v2: 토큰 필터 any / v3: 토큰 필터 all → any (채택) / v4: 의미 점수 + 토큰 가산점
SEARCH_MODE=v3
